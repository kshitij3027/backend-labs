# API Rate Limiter & Quota Manager — example environment overrides.
#
# Copy to `.env` and adjust. Docker Compose reads API_PORT for the load balancer's host port
# mapping; both API replicas read everything from "Server / logging" down to "CORS" via
# src/config.py (Settings — each env var name is the upper-cased field name). The verification
# gates at the bottom are read by scripts/verify_e2e.py and scripts/load_test.py through the compose
# `e2e` and `loadtest` services, NOT by the backend.
#
# Every value below is the compose default, spelled out. `docker compose up` works on a clean
# clone with no .env at all — this file exists so the whole configuration surface is visible in
# one place, and so an operator can see which knobs are the service's and which are the harness's.
#
# This file is a COMMITTED template: it must never contain a real signing key, pepper or admin
# token. The three secrets below are DEV-ONLY placeholders — see the loud note in that section.

# --- Host ports (docker-compose; override if 8020 is taken by a sibling project) ---
API_PORT=8020                            # nginx's host port. NEITHER api replica publishes one:
                                         #   the only way in from the host is through the LB, so
                                         #   the default way to use this project is the
                                         #   distributed one. The harnesses reach the stack by
                                         #   SERVICE NAME over the compose network and ignore this.

# --- Server / logging ---
LOG_LEVEL=INFO                           # root log level (DEBUG | INFO | WARNING | ERROR)

# --- Shared state: Redis ---
# ONE bucket, ONE quota counter, ONE clock, for however many API replicas exist. A token bucket in
# Python memory is not a rate limit once there are two replicas — it is TWO rate limits.
REDIS_URL=redis://redis:6379/0           # the store every replica shares
REDIS_MAX_CONNECTIONS=32                 # pool ceiling PER PROCESS (Redis is single-threaded;
                                         #   past a point extra connections add queueing)
REDIS_TIMEOUT_MS=250                     # connect AND socket timeout. The rate-limit check has a
                                         #   5 ms budget, so a store that stopped answering must be
                                         #   classified as failed in milliseconds, not seconds.

# --- Secrets ---
# !!  ALL THREE ARE REQUIRED AND THE EMPTY DEFAULT IS REJECTED. Settings refuses to construct    !!
# !!  without them, so the process fails loudly at startup rather than signing tokens with no    !!
# !!  key, storing unpeppered API-key digests, or serving an open admin API.                     !!
# !!  The values below are DEV-ONLY and must be replaced for anything that is not a laptop:      !!
# !!      JWT_SECRET=$(openssl rand -hex 32)                                                     !!
# !!  Every replica MUST get the SAME value for each: a different pepper makes the same API key  !!
# !!  hash differently on each replica (identity becomes replica-dependent, indistinguishable    !!
# !!  from an intermittent auth outage), and a different JWT_SECRET makes a token minted for one  !!
# !!  replica a forgery to the other.                                                            !!
JWT_SECRET=dev-only-insecure-signing-key-0123456789abcdef      # HS256 signing key — REPLACE ME
JWT_ALGORITHM=HS256                      # token signing algorithm
ACCESS_TOKEN_TTL_MIN=30                  # access-token lifetime, minutes
API_KEY_PEPPER=dev-only-insecure-pepper-0123456789abcdef       # HMAC-SHA256 pepper — REPLACE ME
                                         #   Lives in the process environment and NEVER in Redis,
                                         #   so a stolen dump yields digests an attacker cannot
                                         #   invert. Rotating it invalidates every stored key.
ADMIN_TOKEN=dev-only-insecure-admin-token-0123456789abcdef     # control-plane token — REPLACE ME

# --- Limits and quotas ---
RATE_LIMIT_ENABLED=true                  # operability switch for the WHOLE enforcement path.
                                         #   With it false the service serves every request
                                         #   unauthenticated and records nothing — the only
                                         #   surface that says so is `rate_limit_enabled` on
                                         #   /dashboard/api/stats.
TIER_LIMITS=free:60:60:1000:25000,premium:300:300:50000:1250000,enterprise:1000:1000:500000:12500000
                                         #   tier:rpm:burst:daily_quota:monthly_quota, comma-sep.
                                         #   Seeded into Redis with HSETNX; the LIVE values are
                                         #   read from there and can be changed at runtime through
                                         #   PUT /api/v1/admin/tiers/{tier} with no restart.
DEFAULT_TIER=free                        # applied to a principal with no `tier` in `user:{id}`.
                                         #   The most restrictive tier, deliberately.
ENDPOINT_COSTS=logs_query:5,logs_ingest:2,default:1
                                         #   weighted per-request cost by endpoint category.
                                         #   NOTE: a metered path with a TRAILING SLASH is charged
                                         #   twice (5 for the 307 + 5 for the redirect).
BUCKET_TTL_SEC=3600                      # floor for a token bucket's TTL; the script actually sets
                                         #   max(this, time-to-refill) so expiry never gifts a
                                         #   caller a full bucket
SLIDING_WINDOW_SEC=60                    # width of the account-wide sliding window
SLIDING_WINDOW_ENABLED=true              # second rate gate, across all endpoints
QUOTA_DAILY_ENABLED=true                 # daily quota counter (UTC day)
QUOTA_MONTHLY_ENABLED=true               # monthly quota counter (UTC month)
TIER_CACHE_TTL_SEC=5                     # bound within which a tier DEFINITION change reaches the
                                         #   replica that did not serve the write. Assigning a USER
                                         #   to a tier has no such window — that is read inside the
                                         #   Lua script on every request. E2E check 11 asserts both
                                         #   halves of that asymmetry.

# --- Analytics ---
ANALYTICS_MINUTE_TTL_SEC=3600            # retention for minute buckets
ANALYTICS_HOUR_TTL_SEC=604800            # retention for hour buckets
ANALYTICS_MAX_BUCKETS=120                # cap on the fan-in of one stats read

# --- Degradation (fail-open) ---
FAIL_MODE=open                           # `open` serves unmetered when Redis is unreachable and
                                         #   stamps X-RateLimit-Degraded: 1; `closed` refuses.
API_REPLICAS=2                           # sizes each replica's degraded fallback bucket at
                                         #   ceil(tier_capacity / API_REPLICAS). MUST track the
                                         #   number of api* services in docker-compose.yml — a
                                         #   third replica without changing this hands the three
                                         #   of them 3 x ceil(cap/2) during an outage.
BREAKER_FAILURES=5                       # consecutive store failures before the breaker opens
BREAKER_COOLDOWN_SEC=5                   # how long it stays open before a trial request

# --- Test-only seam, inert in production ---
ALLOW_CLOCK_OVERRIDE=false               # gates the Lua script's now_ms_override ARGV. A
                                         #   caller-supplied clock is precisely the skew
                                         #   vulnerability the design removed, so it stays false
                                         #   outside the tests that need a frozen clock.

# --- Dashboard ---
DASHBOARD_POLL_MS=5000                   # how often the page re-requests /dashboard/api/stats.
                                         #   Served BY the API so the interval has one source of
                                         #   truth rather than one in Python and one in JavaScript.

# --- CORS ---
CORS_ORIGINS=*                           # comma-separated allowed origins, or `*` for any.
                                         #   With `*`, credentials are disabled (CORS spec).

# =======================================================================================
# Verification gates — read by the two black-box harnesses (scripts/verify_e2e.py and
# scripts/load_test.py), NOT the backend. Defaults are calibrated to pass with margin;
# every gate is host-overridable so a deliberately impossible bar proves the gate bites
# rather than decorates:
#
#     MAX_OVERHEAD_MS=0 make e2e             MUST exit non-zero
#     E2E_BURST_REQUESTS=1 make e2e          MUST exit non-zero
#     LOAD_MIN_RPS=1000000 make load         MUST exit non-zero
#     LOAD_MAX_OVERHEAD_MS=0 make load       MUST exit non-zero
#     MAX_BACKEND_MEM_MB=1 make load         MUST exit non-zero
#
# The second one is not a formality. A burst of one request cannot distinguish a shared
# token bucket from two per-process ones, so a harness that reported PASS for it would be
# worse than no harness at all — it would certify the exact property it never tested.
# =======================================================================================

# --- E2E verifier gates (make e2e; scripts/verify_e2e.py) ---
# Both base URLs are compose-internal and are NOT listed here: the `e2e` service pins them to
# http://lb:80 and http://api1:8000, by service name over the compose network. Pointing the
# verifier at a published host port would let it exercise one replica while believing it had
# exercised two, which is the single configuration in which its headline check means nothing.
E2E_READY_TIMEOUT=90                     # seconds to wait for /health on BOTH base URLs
E2E_REPLICA_PROBES=20                    # /health probes fired to prove the LB fans out (>= 2 hosts)
E2E_BURST_REQUESTS=200                   # requests in the double-spend burst (~3.3x free capacity)
E2E_BURST_CONCURRENCY=50                 # in-flight requests during that burst
E2E_RATE_LIMIT_MARGIN=30                 # requests fired PAST a tier's ceiling to provoke a 429
E2E_QUOTA_LIMIT=3                        # tiny daily quota installed (and restored) for check 10
E2E_TIER_RPM=137                         # distinctive rpm installed (and restored) for check 11.
                                         #   Must differ from the tier's shipped value or the
                                         #   convergence is unobservable.
E2E_TIER_SLACK_SEC=5                     # slack ON TOP of the server's own TIER_CACHE_TTL_SEC.
                                         #   The verifier reads that TTL from the live admin API
                                         #   rather than assuming the value above, so raising
                                         #   TIER_CACHE_TTL_SEC does not silently fail check 11.
E2E_TIER_MAX_WAIT_SEC=15                 # ABSOLUTE ceiling on tier convergence, and the tighter of
                                         #   it and (TTL + slack) is what check 11 grades against.
                                         #   The relative bound ALONE cannot fail: propagation is
                                         #   pure TTL expiry (no pub/sub in src/tiers.py), so the
                                         #   number tolerated and the mechanism under test are the
                                         #   same number. Measured: at TIER_CACHE_TTL_SEC=45 the
                                         #   slow replica took 32.7s and the check passed, budget
                                         #   auto-widened to 50s. With this ceiling in place,
                                         #   `TIER_CACHE_TTL_SEC=45 make e2e` MUST exit non-zero —
                                         #   a stack that converges more slowly than the harness
                                         #   tolerates is itself the finding.
E2E_ANALYTICS_REQUESTS=12                # allowed requests fired for the analytics delta
E2E_ANALYTICS_UNAUTH=5                   # unauthenticated (401) requests fired for the same delta
E2E_ANALYTICS_TIMEOUT=20                 # seconds to wait for that delta to settle on 2 replicas.
                                         #   The analytics write is issued AFTER the response body
                                         #   is on the wire, so the last record can land after the
                                         #   client already has its status line.
E2E_STATS_MINUTES=60                     # minute buckets requested from /dashboard/api/stats
E2E_LATENCY_SAMPLES=40                   # paired (metered, exempt) samples backing the p95
MAX_OVERHEAD_MS=5                        # ceiling on the limiter's measured ADDED p95, ms.
                                         #   Black-box: metered p95 minus exempt p95 on the same
                                         #   stack, decision + analytics included. The clean
                                         #   RATE_LIMIT_ENABLED=false baseline needs a second
                                         #   stack and belongs to C14's load harness, which reads
                                         #   its own LOAD_MAX_OVERHEAD_MS.

# --- Load harness gates (make load; scripts/load_test.py) ---
# The four base URLs are compose-internal and are NOT listed here: the `loadtest` service pins
# them to http://lb:80 (both replicas), http://api1:8000 (one replica), http://api-baseline:8000
# (an api1 running with RATE_LIMIT_ENABLED=false, started only under the `loadtest` profile) and
# the api1,api2 pair the memory phase reads individually. Pointing any of them at a published host
# port would let a phase believe it had addressed a replica it never reached.
#
# Numbers below are MEASURED on the calibration host (a 6-core laptop running the stack and the
# generator together inside Docker Desktop's VM), not guessed. Where a default differs from the
# figure the plan pencilled in, the reason is stated — the plan's numbers were written before
# anything had been run.
LOAD_READY_TIMEOUT=90                    # seconds to wait for /health on every base URL
LOAD_WARMUP_REQUESTS=500                 # unmeasured requests per target before the clock starts.
                                         #   Pays for uvicorn's per-connection setup, the Redis
                                         #   pool's lazy connect and the script cache's first
                                         #   EVALSHA miss OUTSIDE any measurement.
LOAD_SPEC_REQUESTS=100                   # phase A: the spec's own test, "100 parallel requests via
                                         #   httpx, counting 200s vs 429s", printing
                                         #   `Successful: <n>, Rate Limited: <n>`. Must stay ABOVE
                                         #   the free tier's ceiling (60) or the burst never
                                         #   provokes a refusal — and a run that prints
                                         #   `Rate Limited: 0` is failed on purpose, because it
                                         #   would certify the opposite of what it tested.
LOAD_REQUESTS=20000                      # phase B request count. The plan said 5000, assuming
                                         #   ~1000 req/s; measured, the LB leg serves ~6000 req/s,
                                         #   which makes 5000 a 0.8s sample dominated by ramp-up.
                                         #   At 5000 the phase-D ratio spread 1.51-1.72x across
                                         #   repeats; at 20000 it spread 1.59-1.62x.
LOAD_CONCURRENCY=32                      # keep-alive connections in flight during phases B and D,
                                         #   and the number is REDIS_MAX_CONNECTIONS rather than a
                                         #   taste. Phase D's single-replica leg points all of
                                         #   them at ONE replica, which answers out of a pool of
                                         #   32 with a 50ms wait budget; offer more and something
                                         #   is always queueing for a store connection, and that
                                         #   queue lands inside the measurement. Measured on that
                                         #   leg: c=100 -> p95 45ms + 15 x 503 per 8000; c=64 ->
                                         #   1 x 503 per 20000 (a coin flip per run); c=32 ->
                                         #   clean across 3 x 20000, with the replica ALREADY
                                         #   saturated (~4k req/s at 24, 32, 40 and 64 alike, so
                                         #   past ~24 more concurrency buys queueing rather than
                                         #   throughput). The plan said 100.
LOAD_MAX_CLIENT_CPU=0.8                  # cores the LOAD GENERATOR may consume before its own
                                         #   throughput number is declared void. This gate exists
                                         #   because the first three calibration runs breached it:
                                         #   httpx costs 2.41ms of client CPU per request, so the
                                         #   harness measured 569 req/s at 1.00 core, then 1144 at
                                         #   2.87 across three processes — and a phase-D scaling
                                         #   factor of 0.94x, because a saturated client cannot
                                         #   push harder at two replicas than at one. Phases B and
                                         #   D now use a minimal keep-alive HTTP/1.1 client at
                                         #   ~0.05ms/request (~0.2 of a core at ~6000 req/s);
                                         #   phase A still uses httpx because the spec names it.
                                         #   Raising this gate to make a run pass would publish a
                                         #   number about the harness, not about the service.
LOAD_MIN_RPS=3000                        # throughput gate. Three different numbers matter here
                                         #   and this is only one of them: the spec REQUIRES
                                         #   1,000+ req/s (printed as RESULT spec_target_rps and
                                         #   answered by RESULT throughput_meets_spec_target, never
                                         #   gated on — a gate that restates a requirement tests
                                         #   nothing); the stack MEASURES ~5500-7400 req/s through
                                         #   the LB; and this gate is the regression bar at roughly
                                         #   half the observed floor, so losing half the throughput
                                         #   fails the run and a busy laptop does not.
LOAD_OVERHEAD_SAMPLES=200                # paired, interleaved (metered, baseline) samples behind
                                         #   the phase-C percentiles
LOAD_MAX_OVERHEAD_MS=5                   # the spec's "<5ms latency overhead for a rate limit
                                         #   check", as a gate — and unlike the E2E's
                                         #   MAX_OVERHEAD_MS this one is measured against a real
                                         #   RATE_LIMIT_ENABLED=false baseline on the SAME route
                                         #   (C13 could only difference two different handlers).
                                         #   Measured: ~0.25ms added at p95. The delta covers the
                                         #   whole enforcement layer — identity, the Lua decision
                                         #   and the analytics write — because the switch removes
                                         #   all three.
LOAD_SCALING_REQUESTS=                   # requests per leg in phase D. EMPTY means "use
                                         #   LOAD_REQUESTS", so shortening a run cannot leave this
                                         #   phase firing the original volume.
LOAD_MIN_SCALING=1.30                    # rps(2 replicas) / rps(1 replica). Two replicas over ONE
                                         #   Redis CANNOT reach 2.0x — every metered request runs a
                                         #   Lua script on a single-threaded server, so that
                                         #   section is serialised no matter how many API processes
                                         #   exist, and a run reporting 2.0x would mean the
                                         #   decision had stopped serialising (the per-process
                                         #   bucket this whole project exists to prevent).
                                         #   Measured: 1.56x and 1.61x in the shipped arrangement
                                         #   (the harness interleaves the two legs in alternating
                                         #   chunks so a slow patch of machine time lands on both;
                                         #   run sequentially the single-replica leg always went
                                         #   first, in the quietest window, and the ratio came out
                                         #   1.40-1.54x for that reason alone). Across all
                                         #   twenty-two legs at four concurrency settings the band
                                         #   is 1.40-1.72x. The plan pencilled 1.5, which sits
                                         #   INSIDE that spread and would flake — and a gate nobody
                                         #   trusts gets raised until it passes, at which point it
                                         #   is decoration. The measured value is always printed
                                         #   (RESULT scaling_factor); the gate is a floor under it,
                                         #   not a substitute for reading it.
MAX_BACKEND_MEM_MB=150                   # absolute RSS ceiling per replica, MiB, taken over the
                                         #   WORST replica rather than an average — with two
                                         #   processes behind a proxy, an average halves the
                                         #   growth of the one that is actually leaking. Measured:
                                         #   ~66 MiB both at rest and after the run, so this is
                                         #   2.2x the observation.
MAX_MEM_GROWTH_MB=25                     # RSS growth per replica across the whole run, MiB. This
                                         #   is "stable memory usage under sustained load" as a
                                         #   number: every bucket, counter and window this service
                                         #   keeps lives in Redis, so a replica that grows across
                                         #   ~62k requests and ~125 fresh principals is
                                         #   keeping per-caller state it should not have. Measured
                                         #   growth: 0.7 MiB. At 25 this still catches a
                                         #   per-request leak of ~400 bytes.
