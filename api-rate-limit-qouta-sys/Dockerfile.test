# syntax=docker/dockerfile:1.6
#
# Test-runner image for the API Rate Limiter & Quota Manager.
#
# Same base, env and dependency layers as the production image — deliberately byte-identical
# so tests exercise the real code path against the real pinned versions — but it additionally
# COPYs the test suite, its two config files and scripts/, and runs as ROOT so tests can write
# temp files freely (the production image runs as uid 1000 appuser; a test runner has no reason
# to).
#
# This ONE image backs three profile-gated compose services: `test` (pytest), `e2e`
# (scripts/verify_e2e.py, C13) and `loadtest` (scripts/load_test.py, C14). None of them starts on
# a bare `docker compose up`. Shipping src/ here is what lets the harnesses import the demo API
# keys and tier table from src/ instead of hardcoding a second copy that can drift from the one
# the server actually authenticates against.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Parity with production: curl, handy for in-container probes against the live `api` service (or
# the C12 load balancer) over the compose network. No build toolchain needed (all wheels are
# prebuilt manylinux).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first (cached unless requirements.txt changes) — same layer as production. This is
# also the layer that installs fakeredis[lua]: the [lua] extra pulls lupa, without which the
# double cannot EVAL the decision script that is the heart of this project.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# App code + the test suite, plus scripts/ (the C13 E2E verifier and C14 load harness live there;
# the e2e/loadtest compose profiles run them from this same image). scripts/ ships an __init__.py
# from C1 so `python -m scripts.verify_e2e` resolves and this COPY always succeeds even before
# the scripts themselves exist.
COPY src/ ./src/
COPY tests/ ./tests/
COPY scripts/ ./scripts/

# Both config files, together, because coverage is a first-class part of the suite here rather
# than an afterthought: pytest.ini carries the invocation defaults and .coveragerc carries the
# measurement rules (source = src, branch = True). `make test` supplies --cov-fail-under; without
# .coveragerc in the image that gate would measure the wrong tree.
COPY pytest.ini .coveragerc ./

# No flags here: verbosity lives in pytest.ini so it cannot drift between the image default, the
# compose `test` service, and the Makefile targets. A second -q stacks to -qq, which suppresses
# pytest's own "N passed in Xs" summary line. Coverage flags are deliberately NOT here either —
# they belong to `make test` alone (see .coveragerc for why).
CMD ["pytest"]
