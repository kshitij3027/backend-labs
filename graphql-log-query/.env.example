# GraphQL Log Query Platform — example environment overrides.
#
# Copy to `.env` and adjust. Three different readers consume this file, and knowing which is
# which saves an afternoon:
#
#   * Docker Compose reads API_PORT for the host port mapping. It is NOT an application setting —
#     the container CMD hard-codes `--port 8000` and compose maps `${API_PORT:-8020}:8000`.
#   * src/config.py (Settings) reads everything from "Server / logging" down to "CORS". Each env
#     var name is the upper-cased field name, and precedence is: field default -> this file ->
#     environment variable.
#   * scripts/verify_e2e.py and scripts/load_test.py read the verification gates at the bottom
#     (via the compose e2e/loadtest services). The BACKEND never reads any of them.
#
# This file is a COMMITTED template. It carries no secret and needs none: unlike the sibling REST
# project there is no signing key here, which is why `env_file: {required: false}` in compose is
# honest — a clean clone runs with no `.env` at all.
#
# One key, one line, never repeated. A `.env` that names the same key twice silently resolves to
# whichever came last.

# --- Host ports (docker-compose; read by compose, NOT by the app) ---
API_PORT=8020                            # API host port -> uvicorn :8000 in the container.
                                         #   8020 because sibling projects hold 8000 and 8010.

# --- Server / logging ---
HOST=0.0.0.0                             # informational: the image CMD hard-codes --host 0.0.0.0
PORT=8000                                # informational: the image CMD hard-codes --port 8000
LOG_LEVEL=INFO                           # root log level (DEBUG | INFO | WARNING | ERROR)

# --- Database (SQLAlchemy 2.x async) ---
DATABASE_URL=postgresql+asyncpg://gqllogs:gqllogs@postgres:5432/gqllogs
                                         #   +asyncpg, NOT +psycopg2: every resolver is a
                                         #   coroutine, and a blocking driver would park the
                                         #   event loop for the length of each query.
                                         #   `postgres` is the compose SERVICE NAME, not a host.
DB_POOL_SIZE=10                          # persistent connections in the pool
DB_MAX_OVERFLOW=5                        # extra connections allowed above the pool under burst
DB_INIT_RETRIES=10                       # boot-time schema-create attempts before giving up
DB_INIT_RETRY_DELAY_SECONDS=2.0          # delay between those attempts, seconds

# --- Redis (result cache + persisted queries + subscription pub/sub) ---
REDIS_URL=redis://redis:6379/0           # one instance, three jobs. Persistence is disabled in
                                         #   compose: everything stored here is derived, TTL'd
                                         #   state, and a snapshot of a cache is a stale cache.

# --- Seed corpus (deterministic, so the E2E verifier can grade against a regenerated oracle) ---
SEED_ENTRIES=2000                        # log rows generated at startup when the store is empty
SEED_ORDERS=200                          # correlated e-commerce orders generated alongside them
RANDOM_SEED=20260725                     # RNG seed; fixed so the corpus is reproducible

# --- Query limits ---
DEFAULT_QUERY_LIMIT=100                  # `limit` applied when the client omits it. Also the
                                         #   multiplier the cost gate assumes for an unbounded
                                         #   list, so an omitted limit cannot score zero.
MAX_QUERY_LIMIT=500                      # hard ceiling `limit` is clamped to on every path.
                                         #   Must be >= DEFAULT_QUERY_LIMIT or startup fails.

# --- Caching ---
#
# THE CACHE IS TTL-BOUNDED, NOT WRITE-THROUGH. `createLog` invalidates nothing, so an already
# cached `logs` / `logStats` result keeps answering WITHOUT the new row until its TTL expires.
# That is deliberate: invalidating "every key whose filters this row matches" needs a reverse
# index or a keyspace SCAN per write, both of which cost more than the query they save and guard
# a window that is 30 seconds wide anyway. Clients that need the live view subscribe to
# `logStream`, which is never cached. The two numbers below ARE the inconsistency window.
CACHE_ENABLED=true                       # operability switch. `false` is a true bypass: no Redis
                                         #   client is built and no command is ever issued.
CACHE_TTL_SECONDS=30                     # Query.logs TTL. Short on purpose: a log query is a
                                         #   point-in-time answer and a long TTL makes "live"
                                         #   data visibly stale in the dashboard. 0 means
                                         #   "read through, never store" (NOT an error — SETEX
                                         #   rejects a 0 expiry, so the cache skips the write).
AGG_CACHE_TTL_SECONDS=60                 # Query.logStats gets its OWN, longer TTL — far more
                                         #   expensive to compute (SQL GROUP BY over the window)
                                         #   and far less sensitive to one new row. This is the
                                         #   per-aggregation TTL policy C11 extends; the table
                                         #   mapping kind -> setting lives in src/cache.py.

# --- Cost gating (rejected BEFORE execution, during validation) ---
MAX_QUERY_DEPTH=10                       # max operation nesting. GraphQL's cyclic type graph
                                         #   otherwise permits relatedLogs { relatedLogs { … } }
                                         #   forever. Must be >= 1.
MAX_QUERY_COMPLEXITY=25000               # complexity budget: field weights x list multipliers,
                                         #   computed from the AST before any resolver runs.
                                         #   CALIBRATION. The FIELD SELECTIONS below are exact —
                                         #   no field is free, so adding or dropping one changes
                                         #   the number — and every price assumes the two limits
                                         #   above. (`limit:` is shorthand for the real spelling,
                                         #   `filters: {limit: …}`.) Weights: src/graphql/cost.py.
                                         #   ADMITTED
                                         #     mutation createLog{id service}              12
                                         #     logStats{totalLogs errorCount services}     33
                                         #     logsConnection(first:5){totalCount
                                         #       pageInfo{hasNextPage}
                                         #       edges{cursor node{id}}}                   38
                                         #     logs{id service level message}             410
                                         #     logs(limit:8){id relatedLogs{id}}           898
                                         #     logs{id relatedLogs{id}}     (default)   11,110
                                         #     logs{id message relatedLogs{id message}} 21,210
                                         #   REJECTED
                                         #     logs(limit:500){relatedLogs{id}}         55,010
                                         #     logs{relatedLogs{relatedLogs{id}}}    1,101,010
                                         #   THE BOUNDARY. 25000 is chosen so ONE level of
                                         #   correlation at the DEFAULT page size is admitted —
                                         #   that is what relatedLogs and the DataLoader exist
                                         #   for, and a budget that refused it would be broken
                                         #   rather than strict. Nesting MULTIPLIES, so at that
                                         #   page size every extra field under relatedLogs costs
                                         #   100 x 100 = 10,000 and this budget affords two of
                                         #   them; the first realistic shape it refuses is the
                                         #   full 7-field projection on BOTH levels past 34
                                         #   parents (10 + N x 717 > 25,000 at N = 35). Lower
                                         #   `limit` or drop one field under relatedLogs to get
                                         #   back inside. Raising it further only buys fan-out:
                                         #   two levels of correlation is 44x this budget and no
                                         #   plausible number admits that one.
MAX_QUERY_TOKENS=2000                    # ceiling on document size — closes the "enormous but
                                         #   shallow" document that depth alone does not catch
MAX_QUERY_ALIASES=30                     # ceiling on aliases — closes the same field requested
                                         #   ten thousand times under ten thousand names

# --- Persisted queries (APQ) ---
PERSISTED_QUERIES_ENABLED=true           # accept extensions.persistedQuery hash-only requests
PERSISTED_QUERY_TTL_SECONDS=3600         # how long a registered document is retained in Redis

# --- DataLoader ---
DATALOADER_BATCH_WINDOW_MS=0             # how long a loader holds a batch open before dispatching.
                                         #   0 = dispatch on the NEXT EVENT-LOOP TICK, i.e. every
                                         #   key loaded in the current tick joins one batch. That
                                         #   is Strawberry's own behaviour and the only point its
                                         #   DataLoader implements, and it is already the maximal
                                         #   batch here: a selection set's fields resolve
                                         #   concurrently, so all N relatedLogs calls land in one
                                         #   tick. A positive value opens a real hold-open window
                                         #   (implemented in src/graphql/loaders.py, since
                                         #   Strawberry has no such knob) — it widens batches only
                                         #   when loads straddle awaits, and costs up to its own
                                         #   length in latency on the fields that use it.

# --- Subscriptions ---
SUBSCRIPTION_QUEUE_MAXSIZE=500           # per-subscriber bounded queue; overflow DROPS the slow
                                         #   consumer rather than growing server memory.
                                         #   MUST BE >= 1 — asyncio.Queue reads 0 as UNBOUNDED,
                                         #   so 0 removes the bound instead of tightening it and
                                         #   the service refuses to start on it.
MAX_SUBSCRIPTIONS_PER_CONNECTION=10      # cap on operations multiplexed over ONE WebSocket.
                                         #   graphql-transport-ws allows unlimited `subscribe`
                                         #   messages per socket; without this, one connection
                                         #   can allocate unbounded queues.
SUBSCRIPTION_CHANNEL=graphql-log-query:events
                                         #   Redis pub/sub channel bridging workers, so
                                         #   subscriptions survive `uvicorn --workers N`

# --- GraphQL IDE ---
GRAPHQL_PLAYGROUND_ENABLED=true          # serve GraphiQL on GET /graphql (POST is unaffected)

# --- Metrics ---
METRICS_ENABLED=true                     # expose GET /metrics (Prometheus text exposition)

# --- CORS ---
CORS_ORIGINS=*                           # comma-separated allowed origins, or `*` for any.
                                         #   With `*`, credentials are disabled (CORS spec).
                                         #   The dashboard is served by this same process, so
                                         #   the SPA path has no CORS in it at all; this is for
                                         #   third-party clients and a Vite dev server.
                                         #   e.g. CORS_ORIGINS=http://localhost:5173

# =======================================================================================
# Verification gates — read by the E2E verifier / load harness, NOT the backend. Defaults
# are provisional at C1 and are re-calibrated at C14 from the harness's own RESULT lines;
# every gate is host-overridable so a deliberately impossible bar proves the gate bites
# (e.g. `LOAD_MIN_RPS=1000000 make load` MUST fail).
# =======================================================================================

# There are TWO p95 ceilings and they are not interchangeable. MAX_P95_MS bounds the E2E's
# SEQUENTIAL reads — one request in flight, so it measures service time. LOAD_MAX_P95_MS bounds
# the load harness's phases, which run at LOAD_CONCURRENCY in front of a SINGLE uvicorn process,
# where Little's Law puts mean latency at concurrency/throughput before the server has done
# anything wrong, and the tail sits well above that. A p95 measured under queueing and a p95
# measured without it are different quantities; giving them one number fails a healthy server on
# arithmetic. Keep them separate.

# --- E2E verifier gates (make e2e; scripts/verify_e2e.py) ---
E2E_READY_TIMEOUT=90                     # seconds to wait for /health before giving up
MAX_P95_MS=250                           # SEQUENTIAL query p95 ceiling, ms. The spec's own
                                         #   success criterion is <100 ms for a simple query;
                                         #   this CI bar is deliberately looser so host noise
                                         #   cannot fail a healthy build, while still catching a
                                         #   real regression. The measured number is reported in
                                         #   README.md at C14.
MAX_BACKEND_MEM_MB=600                   # backend RSS ceiling, MB (shared: e2e + load). Taken
                                         #   from the SERVER's own psutil probe, never the
                                         #   client's — a harness measuring itself measures
                                         #   nothing.
E2E_SUB_TIMEOUT=20                       # seconds to wait for a subscription frame at all
E2E_SUB_LATENCY_MS=100                   # createLog -> WebSocket end-to-end delivery ceiling,
                                         #   ms. This one IS a spec number (Feature Area C).

# --- Load / perf harness gates (make load; scripts/load_test.py) ---
LOAD_READY_TIMEOUT=90                    # seconds to wait for /health before giving up
LOAD_REQUESTS=2000                       # total operations fired at the API
LOAD_CONCURRENCY=100                     # max in-flight requests (asyncio.Semaphore). 100
                                         #   because that is the spec's own criterion, not a
                                         #   round number.
LOAD_MIN_RPS=100                         # throughput floor, successful operations/second
LOAD_MAX_ERROR_RATE=0.0                  # tolerated fraction of failed operations (0.0 = none)
LOAD_MAX_P95_MS=2000                     # UNDER-LOAD p95 ceiling, ms — see the note above for
                                         #   why this is not MAX_P95_MS
LOAD_MAX_AVG_MS=1500                     # UNDER-LOAD mean ceiling, ms. The spec targets sub-100
                                         #   ms average at 100 concurrent; at c=100 in front of
                                         #   one uvicorn worker that requires ~1000 rps, so this
                                         #   starts loose and is tightened at C14 once the cache
                                         #   and APQ layers are measurable.
LOAD_SUB_CLIENTS=8                       # concurrent WebSocket subscribers held open in the
                                         #   fan-out phase
LOAD_SUB_SECONDS=10                      # how long those subscribers are held open

# The load harness ALSO reads MAX_BACKEND_MEM_MB (declared once, above, with the E2E gates) for
# its final memory phase. It is deliberately not repeated here.
