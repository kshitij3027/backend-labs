# Log Query API (REST) — example environment overrides.
#
# Copy to `.env` and adjust. Docker Compose reads API_PORT for the host port mapping; the API
# reads everything from "Server / logging" down to "CORS" via src/config.py (Settings — each
# env var name is the upper-cased field name). The verification gates at the bottom are read
# by scripts/verify_e2e.py and scripts/load_test.py (via the compose e2e/loadtest services),
# NOT by the backend.
#
# This file is a COMMITTED template: it must never contain a real signing key. The JWT_SECRET
# below is a placeholder that the service rejects on purpose — see the loud note in the Auth
# section.

# --- Host ports (docker-compose; override if 8000/8010 are taken by sibling projects) ---
API_PORT=8010                            # API host port (mapped to uvicorn :8000 in the container)

# --- Server / logging ---
LOG_LEVEL=INFO                           # root log level (DEBUG | INFO | WARNING | ERROR)

# --- Auth (src/config.py) -------------------------------------------------------------
# !!  JWT_SECRET IS REQUIRED AND HAS NO USABLE DEFAULT.                                 !!
# !!  The service REFUSES TO START on an empty, too-short (<16 chars) or placeholder     !!
# !!  value — it exits loudly at startup rather than quietly signing tokens with a demo  !!
# !!  key. Generate a real one with:   openssl rand -hex 32                              !!
# !!  The value shipped below is a PLACEHOLDER and is REJECTED ON PURPOSE, so copying    !!
# !!  this file verbatim fails fast instead of silently becoming your production secret. !!
JWT_SECRET=change-me                     # HS256 signing key — REPLACE ME (rejected as-is)
JWT_ALGORITHM=HS256                      # token signing algorithm
ACCESS_TOKEN_TTL_MIN=30                  # access-token lifetime, minutes

# --- Log store (in-memory ring) ---
STORE_CAPACITY=100000                    # max entries retained; oldest are evicted past this
SEED_ENTRIES=10000                       # entries generated into the store at startup (0 = empty)

# --- Pagination ---
DEFAULT_PAGE_SIZE=50                     # `limit` applied when the client omits it
MAX_PAGE_SIZE=500                        # ceiling `limit` is CLAMPED to (never a 422)

# --- SSE streaming (GET /api/v1/logs/stream) ---
SSE_HEARTBEAT_SEC=15                     # comment-frame keepalive interval, seconds
SSE_QUEUE_SIZE=1000                      # per-subscriber buffer; overflow DROPS the slow consumer
MAX_STREAMS_PER_PRINCIPAL=3              # concurrent SSE connections allowed per principal

# --- Rate limiting (per-principal token bucket, sized by tier) ---
RATE_LIMIT_ENABLED=true                  # operability switch for the limiter (true|false)
TIER_LIMITS=free:10:20,pro:100:200,enterprise:1000:2000
                                         #   tier:sustained_rate_per_sec:burst, comma-separated

# --- Stats ---
STATS_BUCKET_SEC=60                      # time-bucket width for the /stats histogram, seconds

# --- CORS ---
CORS_ORIGINS=*                           # comma-separated allowed origins, or `*` for any.
                                         #   With `*`, credentials are disabled (CORS spec).
                                         #   e.g. CORS_ORIGINS=http://localhost:5173,https://app.example

# =======================================================================================
# Verification gates — read by the E2E verifier / load harness, NOT the backend. Defaults
# are calibrated to pass with margin; every gate is host-overridable so a deliberately
# impossible bar proves the gate bites (e.g. `LOAD_MIN_RPS=1000000 make load` MUST fail).
# =======================================================================================

# There are TWO p95 ceilings and they are not interchangeable. MAX_P95_MS bounds the E2E's
# SEQUENTIAL reads (one request in flight, so it measures service time). LOAD_MAX_P95_MS bounds
# the load harness's phases, which run at LOAD_CONCURRENCY in front of a SINGLE uvicorn process
# — there, Little's Law puts mean latency at concurrency/throughput before the server has done
# anything wrong, and the tail sits well above that. A p95 measured under queueing and a p95
# measured without it are different quantities; giving them one number fails a healthy server
# on arithmetic. Keep them separate.

# --- E2E verifier gates (make e2e; scripts/verify_e2e.py) ---
E2E_READY_TIMEOUT=90                     # seconds to wait for /health before giving up
E2E_PAGE_LIMIT=100                       # page size used for the full cursor walk
E2E_SSE_TIMEOUT=15                       # seconds to wait for the post-connect SSE marker
E2E_RATE_LIMIT_PROBE=60                  # rapid requests fired to provoke a 429 on the free tier
E2E_LATENCY_SAMPLES=50                   # samples backing the p95 latency check
MAX_P95_MS=250                           # SEQUENTIAL read p95 ceiling, ms (e2e check 15 only)
MAX_BACKEND_MEM_MB=400                   # backend RSS ceiling, MB (shared: e2e + load)

# --- Load / perf harness gates (make load; scripts/load_test.py) ---
LOAD_READY_TIMEOUT=90                    # seconds to wait for /health before giving up
LOAD_REQUESTS=2000                       # total requests fired at the API (phase B fires half)
LOAD_CONCURRENCY=50                      # max in-flight requests (asyncio.Semaphore)
LOAD_MIN_RPS=200                         # throughput floor, successful requests/second
LOAD_MAX_ERROR_RATE=0.0                  # tolerated fraction of failed requests (0.0 = none)
LOAD_MAX_P95_MS=800                      # UNDER-LOAD p95 ceiling, ms (measured ~370-386 at c=50)
LOAD_SSE_CLIENTS=8                       # concurrent SSE clients held open during fan-out
LOAD_SSE_SECONDS=10                      # how long the SSE fan-out clients are held open
LOAD_MIN_SSE_EVENTS=5                    # minimum events each SSE client must receive

# Both harnesses ALSO read MAX_STREAMS_PER_PRINCIPAL (declared once, above, with the backend
# settings) so they can probe and spread around the api's own SSE cap. It is deliberately not
# repeated here: one key, one line, or a `.env` silently resolves to whichever came last.
